# Apache config for hosting the BarBrawl Expo web bundle on Hostinger
# in a subfolder (e.g. lucidwinds.com/barbrawl/).
#   1. Long Cache-Control on hashed asset files for instant repeat loads;
#      never cache index.html so deploys take effect.
#   2. Rewrite every unknown URL to index.html so expo-router deep links
#      (/map, /battle, /tree, etc.) work on reload + direct navigation.
# Copied into dist/ by the deploy workflow after `expo export`.

# ---- caching ----------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# ---- SPA fallback ------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /barbrawl/

  # Don't rewrite real files or directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise hand the URL to expo-router via index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# ---- mime types --------------------------------------------------------
AddType application/javascript .mjs
AddType application/json .json
